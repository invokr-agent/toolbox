      "source": "tools/yuanbao_tools.py",
      "line": 502,
      "schema": "{'name': 'yb_query_group_info', 'description': \"Query basic info about a group (called '\u6d3e/Pai' in the app), including group name, owner, and member count.\", 'parameters': {'type': 'object', 'properties': {'group_code': {'type': 'string', 'description': 'The unique group identifier (group_code).'}}, 'required': ['group_code']}}",
