{
  "name": "yaml_query",
  "description": "Select a YAML value by JSON Pointer; reject aliases and custom tags.",
  "namespace": "hammer",
  "example": "{\"name\": \"yaml_query\", \"arguments\": {\"text\": \"service:\\n  port: 8080\", \"pointer\": \"/service/port\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "YAML document.",
        "maxLength": 32000
      },
      "pointer": {
        "type": "string",
        "description": "JSON Pointer; empty selects root.",
        "maxLength": 32000,
        "default": ""
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": false,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 3,
    "memory_mb": 128,
    "output_kb": 32
  }
}
