{
  "name": "markdown_convert",
  "description": "Convert Markdown to HTML with tables and fenced code blocks.",
  "namespace": "hammer",
  "example": "{\"name\": \"markdown_convert\", \"arguments\": {\"text\": \"# Hello\\n\\n**world**\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Markdown source.",
        "maxLength": 32000
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": false,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 3,
    "memory_mb": 128,
    "output_kb": 32
  }
}
