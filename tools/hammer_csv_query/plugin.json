{
  "name": "hammer_csv_query",
  "description": "Filter CSV rows by exact column value; return JSON rows.",
  "namespace": "hammer",
  "example": "{\"name\":\"hammer_csv_query\",\"arguments\":{\"text\":\"name,role\\nAda,engineer\\nLin,writer\\n\",\"column\":\"role\",\"equals\":\"engineer\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "CSV with a unique header row.",
        "maxLength": 32000
      },
      "column": {
        "type": "string",
        "description": "Filter column; omit for all rows.",
        "maxLength": 32000,
        "default": ""
      },
      "equals": {
        "type": "string",
        "description": "Exact filter value.",
        "maxLength": 32000,
        "default": ""
      },
      "limit": {
        "type": "integer",
        "description": "Maximum returned rows.",
        "default": 50,
        "minimum": 1,
        "maximum": 200
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": false,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 3,
    "memory_mb": 128,
    "output_kb": 32
  }
}
