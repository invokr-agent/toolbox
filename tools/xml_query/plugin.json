{
  "name": "xml_query",
  "description": "Select XML elements by a simple ElementTree path; reject DTDs and entities.",
  "namespace": "hammer",
  "example": "{\"name\": \"xml_query\", \"arguments\": {\"text\": \"<root><item id=\\\"1\\\">hello</item></root>\", \"path\": \"./item\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "XML document.",
        "maxLength": 32000
      },
      "path": {
        "type": "string",
        "description": "ElementTree path, default . selects root.",
        "maxLength": 32000,
        "default": "."
      },
      "limit": {
        "type": "integer",
        "description": "Maximum elements.",
        "default": 50,
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": false,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 3,
    "memory_mb": 128,
    "output_kb": 32
  }
}
