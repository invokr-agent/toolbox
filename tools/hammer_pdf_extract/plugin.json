{
  "name": "hammer_pdf_extract",
  "description": "Extract a bounded PDF page text layer from base64 bytes; no OCR.",
  "namespace": "hammer",
  "example": "{\"name\": \"hammer_pdf_extract\", \"arguments\": {\"base64\": \"\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "base64": {
        "type": "string",
        "description": "Base64 PDF bytes.",
        "maxLength": 32000
      },
      "page": {
        "type": "integer",
        "description": "One-based page number.",
        "default": 1,
        "minimum": 1,
        "maximum": 10000
      },
      "limit": {
        "type": "integer",
        "description": "Maximum returned text characters.",
        "default": 8000,
        "minimum": 1,
        "maximum": 12000
      }
    },
    "required": [
      "base64"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": false,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 3,
    "memory_mb": 128,
    "output_kb": 32
  }
}
