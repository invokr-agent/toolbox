{
  "name": "hammer_ha_call_service",
  "description": "Call one Home Assistant service with explicit JSON data.",
  "namespace": "hammer",
  "example": "{\"name\": \"hammer_ha_call_service\", \"arguments\": {\"domain\": \"light\", \"service\": \"turn_on\", \"data\": \"{\\\"entity_id\\\":\\\"light.kitchen\\\"}\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "domain": {
        "type": "string",
        "description": "Service domain.",
        "maxLength": 128
      },
      "service": {
        "type": "string",
        "description": "Service name.",
        "maxLength": 128
      },
      "data": {
        "type": "string",
        "description": "JSON object with service arguments.",
        "maxLength": 8000,
        "default": "{}"
      }
    },
    "required": [
      "domain",
      "service"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": true,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 15,
    "memory_mb": 128,
    "output_kb": 32
  },
  "network": {
    "allow_hosts": [
      "homeassistant.example.invalid"
    ]
  }
}
