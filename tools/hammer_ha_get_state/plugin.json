{
  "name": "hammer_ha_get_state",
  "description": "Read the current Home Assistant state of one entity.",
  "namespace": "hammer",
  "example": "{\"name\": \"hammer_ha_get_state\", \"arguments\": {\"entity_id\": \"light.kitchen\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "entity_id": {
        "type": "string",
        "description": "Entity ID, such as light.kitchen.",
        "maxLength": 128
      }
    },
    "required": [
      "entity_id"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": true,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 15,
    "memory_mb": 128,
    "output_kb": 32
  },
  "network": {
    "allow_hosts": [
      "homeassistant.example.invalid"
    ]
  }
}
