{
  "name": "hammer_spotify_devices",
  "description": "List available Spotify playback devices.",
  "namespace": "hammer",
  "example": "{\"name\": \"hammer_spotify_devices\", \"arguments\": {\"action\": \"list\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "Operation.",
        "maxLength": 32000,
        "enum": [
          "list"
        ]
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask_once"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": true,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 15,
    "memory_mb": 128,
    "output_kb": 32
  },
  "network": {
    "allow_hosts": [
      "api.spotify.com"
    ]
  }
}
