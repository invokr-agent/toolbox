{
  "name": "hammer_discord",
  "description": "Read Discord channel messages or send a text message.",
  "namespace": "hammer",
  "example": "{\"name\": \"hammer_discord\", \"arguments\": {\"action\": \"read\", \"channel_id\": \"123\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "Read or send.",
        "maxLength": 32000,
        "enum": [
          "read",
          "send"
        ]
      },
      "channel_id": {
        "type": "string",
        "description": "Discord channel ID.",
        "maxLength": 20
      },
      "text": {
        "type": "string",
        "description": "Message text for send.",
        "maxLength": 2000,
        "default": ""
      },
      "limit": {
        "type": "integer",
        "description": "Maximum messages to read.",
        "default": 10,
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "action",
      "channel_id"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": true,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 15,
    "memory_mb": 128,
    "output_kb": 32
  },
  "network": {
    "allow_hosts": [
      "discord.com"
    ]
  }
}
