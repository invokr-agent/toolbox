{
  "name": "xlsx_read",
  "description": "Read cached cell values from a base64 XLSX worksheet; never evaluate formulas.",
  "namespace": "hammer",
  "example": "{\"name\": \"xlsx_read\", \"arguments\": {\"base64\": \"\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "base64": {
        "type": "string",
        "description": "Base64 XLSX bytes.",
        "maxLength": 32000
      },
      "sheet": {
        "type": "integer",
        "description": "Worksheet file number (sheet1.xml is 1).",
        "default": 1,
        "minimum": 1,
        "maximum": 100
      },
      "limit": {
        "type": "integer",
        "description": "Maximum cells.",
        "default": 100,
        "minimum": 1,
        "maximum": 200
      }
    },
    "required": [
      "base64"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": false,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 3,
    "memory_mb": 128,
    "output_kb": 32
  }
}
