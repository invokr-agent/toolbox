{
  "name": "hammer_feishu_drive_reply_comment",
  "description": "Post a text reply to a Feishu comment.",
  "namespace": "hammer",
  "example": "{\"name\": \"hammer_feishu_drive_reply_comment\", \"arguments\": {\"file_token\": \"doc123\", \"comment_id\": \"comment123\", \"text\": \"Example comment\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "file_token": {
        "type": "string",
        "description": "Document file token.",
        "maxLength": 128
      },
      "comment_id": {
        "type": "string",
        "description": "Comment identifier.",
        "maxLength": 128
      },
      "text": {
        "type": "string",
        "description": "Plain text to post.",
        "maxLength": 4000
      }
    },
    "required": [
      "file_token",
      "comment_id",
      "text"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": true,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 15,
    "memory_mb": 128,
    "output_kb": 32
  },
  "network": {
    "allow_hosts": [
      "open.feishu.cn"
    ]
  }
}
