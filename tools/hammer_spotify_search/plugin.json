{
  "name": "hammer_spotify_search",
  "description": "Search Spotify for tracks, artists or albums.",
  "namespace": "hammer",
  "example": "{\"name\": \"hammer_spotify_search\", \"arguments\": {\"query\": \"Bach\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Search text.",
        "maxLength": 500
      },
      "kind": {
        "type": "string",
        "description": "Result type.",
        "maxLength": 32000,
        "default": "track",
        "enum": [
          "track",
          "artist",
          "album"
        ]
      },
      "limit": {
        "type": "integer",
        "description": "Maximum results.",
        "default": 5,
        "minimum": 1,
        "maximum": 10
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask_once"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": true,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 15,
    "memory_mb": 128,
    "output_kb": 32
  },
  "network": {
    "allow_hosts": [
      "api.spotify.com"
    ]
  }
}
