{
  "name": "hammer_code_outline",
  "description": "List Python classes, functions, arguments and docstrings without executing source.",
  "namespace": "hammer",
  "example": "{\"name\": \"hammer_code_outline\", \"arguments\": {\"text\": \"def greet(name):\\n    return name\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Python source code.",
        "maxLength": 32000
      },
      "limit": {
        "type": "integer",
        "description": "Maximum symbols.",
        "default": 100,
        "minimum": 1,
        "maximum": 200
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": false,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 3,
    "memory_mb": 128,
    "output_kb": 32
  }
}
