{
  "name": "ha_list_services",
  "description": "List Home Assistant services, optionally filtered by domain.",
  "namespace": "hammer",
  "example": "{\"name\": \"ha_list_services\", \"arguments\": {\"domain\": \"light\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "domain": {
        "type": "string",
        "description": "Domain or empty for all.",
        "maxLength": 128
      }
    },
    "required": [
      "domain"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask_once"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": true,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 15,
    "memory_mb": 128,
    "output_kb": 32
  },
  "network": {
    "allow_hosts": [
      "homeassistant.example.invalid"
    ]
  }
}
