{
  "name": "hammer_regex_search",
  "description": "Find regex matches in supplied text with line numbers.",
  "namespace": "hammer",
  "example": "{\"name\":\"hammer_regex_search\",\"arguments\":{\"text\":\"alpha\\nbeta\\nalpha\",\"pattern\":\"alpha\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Text or source code.",
        "maxLength": 32000
      },
      "pattern": {
        "type": "string",
        "description": "Python regular expression.",
        "maxLength": 32000
      },
      "limit": {
        "type": "integer",
        "description": "Maximum matches.",
        "default": 50,
        "minimum": 1,
        "maximum": 200
      },
      "ignore_case": {
        "type": "boolean",
        "description": "Ignore letter case.",
        "default": false
      }
    },
    "required": [
      "text",
      "pattern"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": false,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 3,
    "memory_mb": 128,
    "output_kb": 32
  }
}
