{
  "name": "hammer_json_query",
  "description": "Select JSON by JSON Pointer; return value or object keys.",
  "namespace": "hammer",
  "example": "{\"name\":\"hammer_json_query\",\"arguments\":{\"text\":\"{\\\"items\\\":[{\\\"name\\\":\\\"Ada\\\"}]}\",\"pointer\":\"/items/0/name\"}}",
  "parameters": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "JSON document.",
        "maxLength": 32000
      },
      "pointer": {
        "type": "string",
        "description": "RFC 6901 pointer; empty selects root.",
        "maxLength": 32000,
        "default": ""
      },
      "mode": {
        "type": "string",
        "description": "Return value or keys.",
        "maxLength": 32000,
        "enum": [
          "value",
          "keys"
        ],
        "default": "value"
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
  "policy": {
    "tiers": [
      "code_execution"
    ],
    "approval": "ask"
  },
  "capabilities": {
    "reads_workspace": false,
    "writes_workspace": false,
    "network": false,
    "executes_code": true
  },
  "daemon": false,
  "limits": {
    "timeout_seconds": 3,
    "memory_mb": 128,
    "output_kb": 32
  }
}
