{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hammer strict subset of invokr 3ffb0f9 toolboxSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "example",
    "parameters",
    "namespace",
    "policy",
    "capabilities",
    "daemon",
    "limits"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "hammer_[a-z][a-z0-9_]*"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "example": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "const": "hammer"
    },
    "daemon": {
      "const": false
    },
    "policy": {
      "const": {
        "tiers": [
          "code_execution"
        ],
        "approval": "ask"
      }
    },
    "capabilities": {
      "const": {
        "reads_workspace": false,
        "writes_workspace": false,
        "network": false,
        "executes_code": true
      }
    },
    "limits": {
      "const": {
        "timeout_seconds": 3,
        "memory_mb": 128,
        "output_kb": 32
      }
    },
    "parameters": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object"
        },
        "additionalProperties": {
          "const": false
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "type",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "default": {},
              "enum": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32000
              }
            }
          }
        }
      }
    }
  }
}
